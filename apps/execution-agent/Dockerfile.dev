FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y bubblewrap git openscad ripgrep xauth xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data /workspace /opt/mato-loop/execution-agent/venv /opt/mato-loop/execution-agent/uv-cache \
    && mv /usr/local/bin/uv /usr/local/bin/uv-real
COPY --chmod=755 docker/uv /usr/local/bin/uv
COPY --chmod=755 docker/entrypoint /usr/local/bin/mato-loop-execution-agent-entrypoint
ENV RUFF_CACHE_DIR=/root/.cache/ruff \
    MATO_EXECUTION_AGENT_CONFIG=/config/config.json

WORKDIR /source/apps/execution-agent

ENTRYPOINT ["mato-loop-execution-agent-entrypoint"]
CMD ["uv", "run", "mato-loop-execution-agent", "run"]
