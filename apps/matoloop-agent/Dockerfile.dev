FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y git openscad ripgrep xauth xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data /workspace /opt/matoloop-agent/venv /opt/matoloop-agent/uv-cache \
    && mv /usr/local/bin/uv /usr/local/bin/uv-real
COPY --chmod=755 docker/uv /usr/local/bin/uv
COPY config.json /usr/share/matoloop-agent/config.json
COPY --chmod=755 docker/entrypoint /usr/local/bin/matoloop-agent-entrypoint
ENV RUFF_CACHE_DIR=/root/.cache/ruff \
    MATOLOOP_AGENT_CONFIG=/data/config.json

WORKDIR /source/apps/matoloop-agent

ENTRYPOINT ["matoloop-agent-entrypoint"]
CMD ["uv", "run", "matoloop-agent", "run"]
