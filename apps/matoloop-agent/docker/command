#!/usr/bin/env python3
"""Run CLI commands in the currently active container release."""

import json
import os
import sys
from pathlib import Path

root = Path(os.environ["MATOLOOP_AGENT_INSTALL_ROOT"])
if sys.argv[1:] == ["update"]:
    os.execv(sys.executable, [sys.executable, str(root / "installer.py"), "container-request"])
state = json.loads((root / "install.json").read_text())
executable = root / state["release"] / "venv/bin/matoloop-agent"
os.execv(executable, [str(executable), *sys.argv[1:]])
