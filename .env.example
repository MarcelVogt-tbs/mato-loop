# MatoLoop production environment.
# Copy this file to .env or configure the same values in the deployment platform.

MATO_LOOP_COMPOSE_PROJECT_NAME=mato-loop

# Replace both placeholders with the same published Forgejo CI commit tag.
MATO_LOOP_IMAGE=git.devmato.net/devmato/matoloop/mato-loop:sha-000000000000
MATOLOOP_AGENT_IMAGE=git.devmato.net/devmato/matoloop/matoloop-agent:sha-000000000000

POSTGRES_DB=matoloop
POSTGRES_USER=matoloop
# Keep this URL-safe because Compose also inserts it into the database URL.
POSTGRES_PASSWORD=replace-with-random-hex

MATO_LOOP_HOST_ADDRESS=0.0.0.0
MATO_LOOP_HOST_PORT=10020
MATO_LOOP_HOST_DB_PATH=/opt/mato-loop/db
MATO_LOOP_HOST_DATA_PATH=/opt/mato-loop/data
MATO_LOOP_SECURE_COOKIES=true
# Required for MCP OAuth behind a reverse proxy; use the public origin without a path.
MATO_LOOP_PUBLIC_BASE_URL=https://matoloop.example.com

MATOLOOP_AGENT_DATA=/opt/matoloop-agent/data
MATOLOOP_AGENT_HOME=/opt/matoloop-agent/home

# Optional non-interactive initial pairing. Remove the token after pairing.
# MATOLOOP_AGENT_ID=00000000-0000-0000-0000-000000000000
# MATOLOOP_AGENT_PAIRING_TOKEN=replace-with-one-time-token
